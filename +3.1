                    if LocalRoot.Anchored == true then break end

                    local Main = Object:FindFirstChild("Main")
                    if not Main then continue end
                    if (Main.Position - LocalRoot.Position).Magnitude >= 6.7 then continue end

                    local genId = Object:GetDebugId()
                    if self.__lastGenId == genId and IsFixingGenerator then break end

                    -- ✅ Estado setado ANTES do spawn (síncrono)
                    IsFixingGenerator   = true
                    self.__puzzleOpenTime = tick()
                    self.__lastGenId      = genId

                    task.spawn(function()
                        local ok, err = pcall(function()
                            local Remotes = Object:FindFirstChild("Remotes")
                            local RemoteEvent = Remotes and Remotes:FindFirstChildOfClass("RemoteEvent")

