                if not GetValue("AutoGeneratorPuzzle") then return true end
                if not IsFixingGenerator then return true end

                -- Puzzle aberto → ainda estou fixando
                if PlayerGui:FindFirstChild("PuzzleUI") then
                    return false
                end

                -- Janela de tolerância pra UI aparecer após o fire
                if self.__puzzleOpenTime > 0 and (tick() - self.__puzzleOpenTime) < 3 then
