{Color3.fromRGB(255,83,53),Color3.fromRGB(255,123,0),Color3.fromRGB(255,83,53)})) end SD["Instance"]=NI NI:SetAttribute("DisplayDescription",SD["DisplayDescription"] or "") NI:SetAttribute("DisplayTitle",SD["DisplayTitle"] or "Untitled Feature") NI:SetAttribute("LayoutOrder",SD["LayoutOrder"] or #NI:GetAttribute("DisplayTitle")) NI:SetAttribute("Requirement",SD["Requirement"]) if SD["ExtraData"] then for EI,EV in SD.ExtraData do NI:SetAttribute(EI,EV) end end NI.Parent=F SetupSettingUI(NI,F,SD) end) end
SetupSettingUI(F)
return F
end

