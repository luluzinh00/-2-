                    if AnimType == false or not AnimType then return end
                    if not BlockableSet[AnimType:lower()] then return end

                    local LocalChar = LocalCharacter
                    if not LocalChar or not LocalChar:FindFirstChild("QueryHitbox") then return end
                    if LocalChar.Parent ~= SurvivorsFolder then return end

                    local SelfHitbox = LocalChar:FindFirstChild("QueryHitbox")
                    if not SelfHitbox then return end

                    if AutoWalkOn then
                        local Root = LocalChar:FindFirstChild("HumanoidRootPart")
                        if Root then
                            local RequireReady = GetValue("AutoWalkRequireBlockReady")
                            local BlockReady = true
                            if RequireReady then
                                BlockReady = IsBlockReady()
                            end

                            local now = tick()
                            if BlockReady and (now - LastAutoWalkTime) >= 2.5 then
                                local Range = tonumber(GetValue("AutoWalkRange")) or 15
                                local QHCheck = GetQueryHitbox()
                                if QHCheck then
                                    local Dist = (QHCheck.Position - Root.Position).Magnitude
                                    if Dist <= Range and HasLineOfSight() then
                                        LastAutoWalkTime = now
                                        task.spawn(function()
                                            ForceWalkToHitbox(0.6)
                                        end)
                                    end
                                end
                            end
                        end
                    end

                    if not AutoBlockOn then return end

                    local SizeMultiplier = tonumber(GetValue("AutoBlockSize")) or 2.2
                    local ShowBoxSetting = GetValue("ShowAutoBlockBox")
                    local ShowHitboxes   = ShowHitboxesSetting and ShowHitboxesSetting.Value
                    local ShouldShowBox  = ShowBoxSetting or ShowHitboxes
                    local Mode           = GetValue("AutoBlockMode") or "Instant"

                    local Custom = CUSTOM_HITBOXES[AnimType:lower()] or CUSTOM_HITBOXES[Killer.Name:lower()]
                    local BaseSize = Custom and Custom.Size or Vector3.new(5.2, 6, 5.65)
                    local OffsetCF = Custom and Custom.Offset or CFrame.new(0, 0, -3.5)

                    local EffectiveMultiplier = SizeMultiplier
                    if Mode == "Intermediate" then
                        local Ping = LocalPlayer:GetNetworkPing() or 0
                        local PingBonus = math.clamp(Ping * 1.5, 0, 1)
                        EffectiveMultiplier = SizeMultiplier * (1 + PingBonus)
                    end

                    local ExpandedSize = Vector3.new(
                        BaseSize.X * EffectiveMultiplier,
                        BaseSize.Y + 1,
                        BaseSize.Z * EffectiveMultiplier
                    )

                    local VisualPart
                    if ShouldShowBox then
                        VisualPart = Instance.new("Part")
                        VisualPart.Name = "KillerDetectHitbox"
                        VisualPart.Color = Color3.fromRGB(0, 255, 255)
                        VisualPart.Size = ExpandedSize
                        VisualPart.CanCollide = false
                        VisualPart.Anchored = true
                        VisualPart.CastShadow = false
                        VisualPart.Material = Enum.Material.ForceField
                        VisualPart.Transparency = 0.7
                        VisualPart.Parent = Hitboxes
                    end

                    local function CheckHit()
                        if not GetValue("AutoBlock") then return false end
                        local QH = GetQueryHitbox()
                        if not QH or not QH.Parent then return false end
                        local BoxCF = QH.CFrame * OffsetCF
                        if VisualPart and VisualPart.Parent then
                            VisualPart.Size = ExpandedSize
                            VisualPart.CFrame = BoxCF
                        end
                        SelfParams.FilterDescendantsInstances = {SelfHitbox}
                        local Hits = workspace:GetPartBoundsInBox(BoxCF, ExpandedSize, SelfParams)
                        if #Hits > 0 and HasLineOfSight() then
                            FireBlock()
                            return true
                        end
                        return false
                    end

                    for _ = 1, 60 do
                        if not Track.IsPlaying then break end

                        if CheckHit() then break end

                        RunService.PreSimulation:Wait()
                        if not Track.IsPlaying then break end
                        if CheckHit() then break end

                        RunService.PreRender:Wait()
                        if not Track.IsPlaying then break end
                        if CheckHit() then break end

                        RunService.RenderStepped:Wait()
                        if not Track.IsPlaying then break end
                        if CheckHit() then break end

                        RunService.Heartbeat:Wait()
                        if not Track.IsPlaying then break end
                        if CheckHit() then break end
                    end

                    if VisualPart and VisualPart.Parent then
                        VisualPart:Destroy()
                    end
                end)
            end,
