local function AddOverridenAnimation(ID) if LocalCharacter and ID then if OverriddenAnimations[ID] then return table.unpack(OverriddenAnimations[ID]) end local OF=LocalCharacter:FindFirstChild("OverrideAnimation") or Instance.new("Folder",LocalCharacter) OF.Name="OverrideAnimation" local AT,CN=GetAnimationType(ID) or "Unknown" local A=Instance.new("Animation") A.Name=AT..tostring(ID) A.AnimationId=tostring(ID):find("id") and tostring(ID) or "http://www.roblox.com/asset/?id="..tostring(ID) A.Parent=OF A:SetAttribute("Overriden",true) if LocalAnimator then local T=LocalAnimator:LoadAnimation(A) OverriddenAnimations[ID]={T,A} return T,A end else return end end

