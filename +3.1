        ["EnableOverride"] = {
            ["DisplayDescription"]="Overrides the puzzle grid size of the generators",
            ["DisplayTitle"]="Override Generator(s) Grid Size",
            ["LayoutOrder"]=16, ["Savable"]=true, ["InstanceType"]="BoolValue", ["DefaultInstanceValue"]=false,
            ["Requirement"]="require"
        },

        -- ✅ CORRIGIDO — GridSize hook sempre ativo + guard no HandlePuzzle
        ["GridSize"] = {
            ["DisplayDescription"]="The Size to override for the Generator's Puzzle",
            ["DisplayTitle"]="Generator(s) Grid Size",
            ["LayoutOrder"]=17, ["Savable"]=true, ["InstanceType"]="NumberValue", ["DefaultInstanceValue"]=6,
            ["Requirement"]="require|EnableOverride",
            ["ExtraData"]={ MaxValue=12, MinValue=4, Step=1 },
            ["HandlePuzzle"] = function(Data)
                PuzzleData = {}
                local function GetDirection(Row1,Col1,Row2,Col2)
                    if Row2 < Row1 then return "up" end
                    if Row2 > Row1 then return "down" end
                    if Col2 < Col1 then return "left" end
                    if Col2 > Col1 then return "right" end
                end
                local function GetPuzzleConnections(Last, New, Next)
                    local Connections = {}
                    if Last and New then
                        local Direction = GetDirection(New.row, New.col, Last.row, Last.col)
                        if Direction == "up" then Direction = "down"
                        elseif Direction == "down" then Direction = "up"
                        elseif Direction == "left" then Direction = "right"
                        elseif Direction == "right" then Direction = "left" end
                        if Direction then Connections[Direction] = true end
                    end
                    if Next and New then
                        local Direction = GetDirection(New.row, New.col, Next.row, Next.col)
                        if Direction then Connections[Direction] = true end
                    end
                    return Connections
                end
                local function NearbyDirection(Row1, Col1, Row2, Col2)
                    if Row2 == Row1 - 1 and Col2 == Col1 then return "up" end
                    if Row2 == Row1 + 1 and Col2 == Col1 then return "down" end
                    if Row2 == Row1 and Col2 == Col1 - 1 then return "left" end
                    if Row2 == Row1 and Col2 == Col1 + 1 then return "right" end
                    return false
                end
                local function GetPlaceKey(Point) return `{Point.row}-{Point.col}` end
                local function PathEndpoints(Path, endpoints)
                    if not Path or #Path == 0 then return Path end
                    local UniquePoint
                    for _, Point in endpoints or {} do
                        for _, v in Path do
                            if v.row == Point.row and v.col == Point.col then UniquePoint = {row=Point.row, col=Point.col}; break end
                        end
                        if UniquePoint then break end
                    end
                    if not UniquePoint then
                        local PointsInPath = {}
                        for _, Point in Path do PointsInPath[GetPlaceKey(Point)] = Point end
                        for _, Point in Path do
                            local Nearby = 0
                            local Directions = {{Point.row-1,Point.col},{Point.row+1,Point.col},{Point.row,Point.col-1},{Point.row,Point.col+1}}
                            for _, D in Directions do
                                if PointsInPath[`{D[1]}-{D[2]}`] then Nearby += 1 end
                            end
                            if Nearby == 1 then UniquePoint = {row=Point.row, col=Point.col}; break end
                        end
                    end
                    if not UniquePoint then UniquePoint = {row=Path[1].row, col=Path[1].col} end
                    local Remaining = {}
                    for _, Point in Path do
                        Remaining[GetPlaceKey(Point)] = {row=Point.row, col=Point.col}
                    end
                    local Ordered = {}
                    local CurrentTableKey = {row=UniquePoint.row, col=UniquePoint.col}
                    local Cloned = table.clone(CurrentTableKey); setmetatable(Cloned, nil)
                    table.insert(Ordered, Cloned)
                    Remaining[GetPlaceKey(CurrentTableKey)] = nil
                    while next(Remaining) do
                        local foundNext = false
                        for key, Point in Remaining do
                            local Direction = NearbyDirection(CurrentTableKey.row, CurrentTableKey.col, Point.row, Point.col)
                            if Direction then
                                local ClonedPoint = table.clone(Point); setmetatable(ClonedPoint, nil)
                                table.insert(Ordered, ClonedPoint)
                                Remaining[key] = nil
                                CurrentTableKey = Point
                                foundNext = true
                                break
                            end
                        end
                        if not foundNext then return Path end
                    end
                    return Ordered
                end
                local function ActivatePuzzlePathfind(_, Puzzle, UI)
                    if not Puzzle or not Puzzle.Solution then return nil end
                    local TotalPaths = #Puzzle.Solution
                    local PuzzlePoints = table.create(TotalPaths)
                    for i = 1, TotalPaths do PuzzlePoints[i] = i end
                    for i = #PuzzlePoints - 1, 2, -1 do
                        local r = math.random(1, i)
                        PuzzlePoints[i+1], PuzzlePoints[r+1] = PuzzlePoints[r+1], PuzzlePoints[i+1]
                    end
                    local IsActiveConnection
                    local function Restart()
                        -- ✅ CORRIGIDO — guard contra re-solve
                        if not GetValue("AutoGeneratorPuzzle") and not GetValue("EnableOverride") then return end
                        if not Puzzle or not Puzzle.Solution then return end
                        if Puzzle.won then return end

                        for _, Color in PuzzlePoints do
                            local Path = Puzzle.Solution[Color]
                            local endpoints = Puzzle.targetPairs[Color]
                            local CompletePath = PathEndpoints(Path, endpoints)
                            Puzzle.paths[Color] = {}
                            for i = 0, #CompletePath - 1 do
                                local Point = CompletePath[i+1]
                                local ColorData = Puzzle.paths[Color]
                                table.insert(ColorData, {row=Point.row, col=Point.col})
                                local Last = CompletePath[i]
                                local Next = CompletePath[i+2]
                                local PuzzleConnections = GetPuzzleConnections(Last, Point, Next)
                                Puzzle.gridConnections = Puzzle.gridConnections or {}
                                Puzzle.gridConnections[`{Point.row}-{Point.col}`] = PuzzleConnections
                                if not GetValue("AutoGeneratorPuzzle") and not GetValue("EnableOverride") then break
                                elseif not UI or not UI.Parent then IsActiveConnection:Disconnect(); break end
                                Puzzle:updateGui()
                                task.wait(GetValue("GeneratorCooldown", true):GetAttribute("CurrentSpeed"))
                                if not GetValue("AutoGeneratorPuzzle") and not GetValue("EnableOverride") then break
                                elseif not UI or not UI.Parent then IsActiveConnection:Disconnect(); break end
                            end
                            if not GetValue("AutoGeneratorPuzzle") and not GetValue("EnableOverride") then break
                            elseif not UI or not UI.Parent then IsActiveConnection:Disconnect(); break end
                            Puzzle:checkForWin()
                        end
                    end
                    IsActiveConnection = GetValue("AutoGeneratorPuzzle", true):GetPropertyChangedSignal("Value"):Connect(Restart)
                    Restart()
                end
                ActivatePuzzlePathfind(PuzzleData, Data[1], Data[2])
            end,
            -- ✅ CORRIGIDO — hook sempre ativo (não depende mais de EnableOverride)
            ["CustomSetup"] = function(self)
                if not (GetValue("require") and FlowGame) then
                    self.Requirement = true
                    return
                end

                if FlowGame:FindFirstChild("Settings") then
                    local SettingsModule = require(FlowGame:FindFirstChild("Settings"))
                    self.DefaultInstanceValue = SettingsModule and SettingsModule.DefaultGridSize or self.DefaultInstanceValue
                end

                local FlowGameFunctions = require(FlowGame)
                local Original = FlowGameFunctions.new

                function FlowGameFunctions.new(...)
                    local Args = {...}

                    -- Substitui grid apenas quando overrides estão ativos
                    if GetValue("EnableOverride") and (type(Args[2]) == type(0) or not Args[2]) then
                        Args[2] = GetValue("GridSize")
                    end

                    GetValue("GeneratorCooldown", true):SetAttribute("CurrentGrid", Args[2] or 6)

                    local Result = { Original(table.unpack(Args)) }

                    -- ✅ Resolve puzzle quando EnableOverride OU AutoGeneratorPuzzle ligados
                    if GetValue("EnableOverride") or GetValue("AutoGeneratorPuzzle") then
                        task.delay(0.35, self.HandlePuzzle, {Result[1], Args[1]})
                    end

                    return Result[1]
                end
            end
        },
    },

