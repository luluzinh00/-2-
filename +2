ocal FV,CV,TR=GetValue("OtherESP"),MD["Document"] and MD["Document"][2] or ColorPresets["White"],v self:CreateDynamicHighlight(FV and not v:GetAttribute("Team") or v:GetAttribute("Team")~=LocalCharacter.Parent.Name,v,TR,{MaxDistance=100,MinDistance=12,Color=CV}) self:CreateText(FV,v,TR,{MinDistance=25,Text=MD["Document"] and MD["Document"][1] or v.Name,Color=CV}) end end end if InGame and GameMap then task.spawn(function() local TS=InGame:QueryDescendants("Tool") for i,v in TS do if v.Parent:IsA("Model") and v.Parent:FindFirstChildOfClass("Humanoid") then continue end local FV,CV,TR=GetValue("ItemsESP"),ColorPresets[GetValue("ItemsColor")],v:FindFirstChildWhichIsA("BasePart") self:CreateDynamicHighlight(FV,v,TR,{MaxDistance=100,MinDistance=12,Color=CV}) self:CreateText(FV,v,TR,{MinDistance=25,Text=v:FindFirstChildWhichIsA("ProximityPrompt",true) and v:FindFirstChildWhichIsA("ProximityPrompt",true).ActionText or v.Name,Color=CV}) if (not LocalCharacter:FindFirstChildOfClass("Tool") or LocalCharacter:FindFirstChildOfClass("Tool").Name~=v.Name) and not LocalPlayer:FindFirstChildOfClass("Backpack"):FindFirstChild(v.Name) and not v:GetAttribute("JustDropped") and GetValue("AutoPickup") then local P=OverlapParams.new() P.BruteForceAllSlow=true P.IncludeInstances={v} local R=workspace:GetPartBoundsInRadius(LocalRoot.Position,4.5,P) if LocalRoot and #R>0 and v:FindFirstChildWhichIsA("ProximityPrompt",true) then FP(v:FindFirstChildWhichIsA("ProximityPrompt",true)) end end end end) for i,v in GameMap:QueryDescendants("Model#Generator:has(#Main)") do task.spawn(function() if (GetValue("GeneratorsCheck"))==true and v:FindFirstChild("Progress") and v:FindFirstChild("Progress").Value>=100 then self:CreateDynamicHighlight(false,v) self:CreateText(false,v) elseif v:FindFirstChild("Progress") then local FV,CV,TR=GetValue("GeneratorsESP"),ColorPresets[GetValue("GeneratorsColor")],v:FindFirstChild("Main") or v:WaitForChild("Main") self:CreateDynamicHighlight(FV,v,TR,{MaxDistance=100,M