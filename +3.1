            ["HandleKiller"] = function(self, Killer)
                local FireSignal   = GetFunction(firesignal, FireSignal)
                local UseActorAbility = Network and Network:FindFirstChildOfClass("RemoteEvent")
                local ShowHitboxesSetting = PlayerData and PlayerData:FindFirstChild("Settings") and PlayerData.Settings:FindFirstChild("ShowHitboxes", true)
                local Humanoid = Killer:FindFirstChildOfClass("Humanoid") or Killer:WaitForChild("Humanoid")
                local QueryHitbox = Killer:FindFirstChild("QueryHitbox") or Killer:WaitForChild("QueryHitbox")
                local KillerAnimator = Humanoid:FindFirstChildOfClass("Animator")
                if not KillerAnimator then return end

                if not self.__BlockableSet then
                    local s = {}
                    for _, v in BLOCKABLE_ATTACKS do s[v] = true end
                    self.__BlockableSet = s
                end
                local BlockableSet = self.__BlockableSet
                local IsOfficialGame = GetValue("OfficialGame")

                local SelfParams = OverlapParams.new()
                SelfParams.MaxParts = 1
                SelfParams.FilterType = Enum.RaycastFilterType.Include

                local function GetQueryHitbox()
                    return Killer:FindFirstChild("QueryHitbox")
                end

                local function HasLineOfSight()
                    local myHitbox = LocalCharacter and LocalCharacter:FindFirstChild("QueryHitbox")
                    local killerHitbox = Killer:FindFirstChild("QueryHitbox")
                    if not myHitbox or not killerHitbox then return false end
                    local RayParams = RaycastParams.new()
                    RayParams.FilterType = Enum.RaycastFilterType.Exclude
                    RayParams.FilterDescendantsInstances = {LocalCharacter, Killer, Hitboxes}
                    RayParams.IgnoreWater = true
                    local Result = workspace:Raycast(myHitbox.Position, killerHitbox.Position - myHitbox.Position, RayParams)
                    return Result == nil
                end

                local function FireBlock()
                    local AbilityContainer = MainUI:FindFirstChild("AbilityContainer")
                    if not AbilityContainer then return end
                    local BlockBtn = AbilityContainer:FindFirstChild("Block")
                    if not BlockBtn then return end
                    if FireSignal then
                        pcall(FireSignal, BlockBtn.MouseButton1Click)
                    end
                    if UseActorAbility then
                        pcall(function()
                            if IsOfficialGame then
                                UseActorAbility:FireServer("UseActorAbility", {"Block"})
                            else
                                UseActorAbility:FireServer("UseActorAbility", "Block")
                                UseActorAbility:FireServer("UseActorAbility", {"Block"})
                            end
                        end)
                    end
                end

                local function IsBlockReady()
                    local AbilityContainer = MainUI:FindFirstChild("AbilityContainer")
                    if not AbilityContainer then return true end
                    local BlockBtn = AbilityContainer:FindFirstChild("Block")
                    if not BlockBtn then return true end

                    local onCD = BlockBtn:GetAttribute("OnCooldown")
                    if onCD ~= nil then return not onCD end

                    local cdAttr = BlockBtn:GetAttribute("Cooldown")
                    if cdAttr ~= nil then
                        if type(cdAttr) == "number" then return cdAttr <= 0 end
                        if type(cdAttr) == "boolean" then return not cdAttr end
                    end

                    local readyAttr = BlockBtn:GetAttribute("IsReady")
                    if readyAttr ~= nil then return readyAttr == true end

                    for _, c in BlockBtn:GetDescendants() do
                        if c:IsA("GuiObject") then
                            local n = c.Name:lower()
                            if n:find("cooldown") or n == "cd" or n:find("timer") then
                                if c.Visible then
                                    local fill = c:FindFirstChild("Fill")
                                        or c:FindFirstChild("Progress")
                                        or c:FindFirstChild("FillFrame")
                                        or c:FindFirstChildWhichIsA("Frame", false)
                                    if fill and fill:IsA("Frame") then
                                        if fill.Size.Y.Scale > 0.05 or fill.Size.Y.Offset > 2 then
                                            return false
                                        end
                                        if fill.Visible and fill.BackgroundTransparency < 0.9 then
                                            return false
                                        end
                                    end
                                    return false
                                end
                            end
                        elseif c:IsA("NumberValue") and (c.Name:lower():find("cooldown") or c.Name == "CD") then
                            if c.Value > 0 then return false end
                        elseif c:IsA("BoolValue") and c.Name:lower():find("cooldown") then
                            if c.Value then return false end
                        end
                    end

                    if BlockBtn:GetAttribute("Disabled") == true then return false end
                    return true
                end

                local function ForceWalkToHitbox(Duration)
                    local Char = LocalCharacter
                    if not Char then return end
                    local Root = Char:FindFirstChild("HumanoidRootPart")
                    local Hum  = Char:FindFirstChildOfClass("Humanoid")
                    if not Root or not Hum then return end

                    local oldBV = Root:FindFirstChild("AutoWalkForceBV")
                    if oldBV then oldBV:Destroy() end
                    local oldGyro = Root:FindFirstChild("AutoWalkForceGyro")
                    if oldGyro then oldGyro:Destroy() end

                    local BV = Instance.new("BodyVelocity")
                    BV.Name = "AutoWalkForceBV"
                    BV.MaxForce = Vector3.new(1e7, 0, 1e7)
                    BV.P = 1e5
                    BV.Velocity = Vector3.zero
                    BV.Parent = Root

                    local BGyro = Instance.new("BodyGyro")
                    BGyro.Name = "AutoWalkForceGyro"
                    BGyro.MaxTorque = Vector3.new(1e7, 1e7, 1e7)
                    BGyro.P = 1e5
                    BGyro.D = 100
                    BGyro.CFrame = Root.CFrame
                    BGyro.Parent = Root

                    local OrigSpeed = (Hum.WalkSpeed and Hum.WalkSpeed > 0) and Hum.WalkSpeed or 16
                    Hum.WalkSpeed = OrigSpeed * 1.30

                    local WalkSpeed = Hum.WalkSpeed
                    local EndTime = tick() + Duration

                    while tick() < EndTime do
                        if not Root.Parent or not Hum.Parent then break end
                        if Hum.Health <= 0 then break end
                        if LocalCharacter ~= Char then break end

                        local QH = GetQueryHitbox()
                        if not QH then break end

                        local Dir = QH.Position - Root.Position
                        Dir = Vector3.new(Dir.X, 0, Dir.Z)
                        if Dir.Magnitude < 1.5 then break end

                        BV.Velocity = Dir.Unit * WalkSpeed

                        local LookPos = Vector3.new(QH.Position.X, Root.Position.Y, QH.Position.Z)
                        pcall(function()
                            BGyro.CFrame = CFrame.lookAt(Root.Position, LookPos)
                        end)

                        pcall(function() Hum:Move(Dir.Unit, false) end)
                        RunService.Heartbeat:Wait()
                    end

                    if Hum and Hum.Parent then Hum.WalkSpeed = OrigSpeed end
                    if BGyro and BGyro.Parent then BGyro:Destroy() end
                    if BV and BV.Parent then BV:Destroy() end
                end

                KillerAnimator.AnimationPlayed:Connect(function(Track)
                    local AutoBlockOn = GetValue("AutoBlock")
                    local AutoWalkOn  = GetValue("AutoWalkToHitbox")
                    if not AutoBlockOn and not AutoWalkOn then return end

                    local AnimID = Track.Animation.AnimationId
                    local AnimType = AnimTypeCache[AnimID]
                    if AnimType == nil then
                        AnimType = GetAnimationType(AnimID) or false
                        AnimTypeCache[AnimID] = AnimType
