local SettingsData,Contents,Templates
local function SetupSettingUI(SI,TSF,TF)
local LO=SI:GetAttribute("LayoutOrder")
local DT=SI:GetAttribute("DisplayTitle")
if LO and DT then
if SI:IsA("Folder") then
local S=Templates.Seperator:Clone() S.Name=SI.Name S.LayoutOrder=LO*100+(TSF and TSF:GetAttribute("LayoutOrder")*100 or 0)
SI:GetAttributeChangedSignal("LayoutOrder"):Connect(function() if SI.Name~="EnviromentFunctions" then S.LayoutOrder=SI:GetAttribute("LayoutOrder")*100+(TSF and TSF:GetAttribute("LayoutOrder")*100 or 0) end end)
S.Title.Text=DT
SI:GetAttributeChangedSignal("DisplayTitle"):Connect(function() if SI.Name~="EnviromentFunctions" then S.Title.Text=SI:GetAttribute("DisplayTitle") end end)
S.Parent=Contents
elseif SI:IsA("ValueBase") then
local ST=Templates:FindFirstChild(SI:GetAttribute("TemplateType") or string.gsub(SI.ClassName,"Value",""))
for i,C in pairs(Templates:GetChildren()) do if SI.Parent.Name:find(C.Name) then ST=C end end
if ST then local MT=ModulesOptions[tostring(ST.Name)] ST=loadstring(tostring(MT))(PlaySound) end
if ST and ST.CreateSettingUI then
local SUI=ST:CreateSettingUI(SI) SUI.Instance.Name=SI.Name TSF=SI.Parent SUI.Instance.LayoutOrder=LO+(TSF and TSF:GetAttribute("LayoutOrder")*100 or 0)
TSF:GetAttributeChangedSignal("LayoutOrder"):Connect(function() SUI.Instance.LayoutOrder=SI:GetAttribute("LayoutOrder")+(TSF and TSF:GetAttribute("LayoutOrder")*100 or 0) end)
SUI.Instance.Parent=Contents
local R=SI:GetAttribute("Requirement")
local BCR=Instance.new("BindableEvent")
local Rs={}
BCR.Event:Connect(function() local AT=true for i,v in pairs(Rs) do if not v then AT=false break end end SUI.Instance.Visible=AT end)
if type(R)=="string" and R:find("|") then for i,v in string.split(R,"|") do Rs[v]=false end else Rs=R and{[R]=false} or{} end
for R,v in pairs(Rs) do
Rs[R]=false
local IV=type(R)=="string" and PlusFolderSettings:FindFirstChild(R,true) or nil
if IV and R~=true then Rs[R]=IV.Value IV:GetPropertyChangedSignal("Value"):Connect(function() Rs[R]=IV.Value BCR:Fire() end)
elseif R==true then Rs[R]=false BCR:Fire()
elseif R:find("=") then
local SD=string.split(R,"=")
local V=SD[2]
local function BC(CI) local function U() if tostring(CI.Value)==V or tostring(CI.Value):lower()=="both" or tostring(CI.Value):lower()=="all" then Rs[R]=true else Rs[R]=false end BCR:Fire() end U() CI:GetPropertyChangedSignal("Value"):Connect(U) end
local CI=PlusFolderSettings:FindFirstChild(SD[1],true)
if CI then BC(CI) else PlusFolderSettings.DescendantAdded:Connect(function(C) if C.Name==SD[1] and C:IsA("ValueBase") then BC(C) end end) end
elseif R:find("~") then
local SD=string.split(R,"~")
local V=SD[2]
local function BC(CI) local function U() if tostring(CI.Value)~=V then Rs[R]=true else Rs[R]=false end BCR:Fire() end U() CI:GetPropertyChangedSignal("Value"):Connect(U) end
local CI=PlusFolderSettings:FindFirstChild(SD[1],true)
if CI then BC(CI) else PlusFolderSettings.DescendantAdded:Connect(function(C) if C.Name==SD[1] and C:IsA("ValueBase") then BC(C) end end) end
elseif R:find(":") then
local SD=string.split(R,":")
local V=SD[2]
local TC=SD[1]
if TC:lower():find("killer") then Rs[R]=KillerAssets and(KillerAssets:FindFirstChild(V) or KillerAssets:FindFirstChild("!"..V)) and true or false
elseif TC:lower():find("survivor") then Rs[R]=SurvivorAssets and(SurvivorAssets:FindFirstChild(V) or SurvivorAssets:FindFirstChild("!"..V)) and true or false
elseif TC:lower():find("gameid") then Rs[R]=V:gsub("[^%d]","")~="" and game.GameId==tonumber(V:gsub("[^%d]",""))
elseif TC:lower():find("placeid") then Rs[R]=V:gsub("[^%d]","")~="" and game.PlaceId==tonumber(V:gsub("[^%d]",""))
elseif TC:lower():find("status") or TC:lower():find("effect") then Rs[R]=StatusEffects and StatusEffects:FindFirstChild(V,true) and true or false end
BCR:Fire()
end
end
PlusFolderSettings.DescendantAdded:Connect(function(C) if not C:IsA("ValueBase") then return end for R,v in pairs(Rs) do if type(R)=="string" and not R:find("=") and not R:find("~") and not R:find(":") and R==C.Name then Rs[R]=C.Value C:GetPropertyChangedSignal("Value"):Connect(function() Rs[R]=C.Value BCR:Fire() end) BCR:Fire() end end end)
BCR:Fire()
SI:GetAttributeChangedSignal("Requirement"):Connect(function() R=SI:GetAttribute("Requirement") Rs={} if type(R)=="string" and R:find("|") then for i,v in string.split(R,"|") do Rs[v]=false end else Rs=R and{[R]=false} or{} end BCR:Fire() end)
local SF=TF
local RB=Templates.Reset:Clone() RB.Parent=SUI.Instance
RB.MouseButton1Click:Connect(function() SI.Value=SF["DefaultInstanceValue"] PlaySound("switch0"..tostring(math.random(1,4))) end)
RB.MouseEnter:Connect(function() PlaySound("hover") end)
RB.MouseLeave:Connect(function() PlaySound("hoverEnd") end)
SUI.Instance:FindFirstChild("SettingName",true).Text=(DT or "")
SI:GetAttributeChangedSignal("DisplayTitle"):Connect(function() SUI.Instance:FindFirstChild("SettingName",true).Text=(SI:GetAttribute("DisplayTitle") or "") end)
SUI.Instance:FindFirstChild("SettingDesc",true).Text=(SI:GetAttribute("DisplayDescription") or "")
SI:GetAttributeChangedSignal("DisplayDescription"):Connect(function() SUI.Instance:FindFirstChild("SettingDesc",true).Text=(SI:GetAttribute("DisplayDescription") or "") end)
SUI.__updatedEvent=Instance.new("BindableEvent",SUI.Instance) SUI.Updated=SUI.__updatedEvent.Event
if SF then
if SF.CustomSetup then task.spawn(SF.CustomSetup,SF) end
SUI.Updated:Connect(function(Starting) if SF.ScriptFunction and SUI.Value~=nil then SF:ScriptFunction(SUI.Value,Starting or false) end end)
CharacterAddedBindable.Event:Connect(function() if SF.CharacterAdded then task.spawn(SF.CharacterAdded,SF) end end)
if SF.OnLoop then ThreadBindable.Event:Connect(function() SF:OnLoop(SF) end) end
end
SUI.Value=SI.Value
if SUI.OnUpdate then SUI:OnUpdate() end
SUI.__updatedEvent:Fire(true)
SI:GetPropertyChangedSignal("Value"):Connect(function() SUI.Value=SI.Value if SUI.OnUpdate then SUI:OnUpdate() end SUI.__updatedEvent:Fire() end)
SettingsData.PlayerSettings[SI.Name]=SUI
task.wait()
end
end
else return end
end

