                elseif Highlight[1] then
                    Highlight[1]:Destroy()
                end
            end,

            ["CreateText"] = function(self, Enabled, ItemInstance, TargetRoot, Settings)
                Settings = type(Settings) == "table" and Settings or {MinDistance=10, Color=Color3.new(1,1,1)}
                local BillboardGui = ItemInstance:QueryDescendants("BillboardGui[$Dynamic]")
                if Enabled and GetValue("ShowText") and GetValue("ESP") then
                    if not BillboardGui[1] then
                        local bg = Instance.new("BillboardGui")
                        local TextLabel = Instance.new("TextLabel")
                        bg.Name = HttpService:GenerateGUID(false):sub(1,7)
                        bg.Archivable = false
                        local isTool = ItemInstance:IsA("Tool")
                        bg.Size = isTool and UDim2.new(1.5,30,0.75,30) or UDim2.new(1.5,60,0.75,25)
                        bg[isTool and "StudsOffsetWorldSpace" or "StudsOffset"] = isTool and Vector3.new(0,3,0) or Vector3.new(0,4,0)
                        bg.AlwaysOnTop = true
                        bg.ResetOnSpawn = false
                        bg.Adornee = TargetRoot
                        bg:SetAttribute("Dynamic", true)
                        TextLabel.Text = Settings.Text or "Unknown"
                        local H, S, V = Settings.Color:ToHSV()
                        TextLabel.TextColor3 = Color3.fromHSV(H, S, V * 1.1)
                        TextLabel.AnchorPoint = Vector2.new(0.5, 0.5)
                        TextLabel.Position = UDim2.fromScale(0.5, 0.5)
                        TextLabel.Size = UDim2.fromScale(1, 1)
                        TextLabel.BackgroundTransparency = 1
                        TextLabel.TextScaled = true
                        TextLabel.Parent = bg
                        bg.Parent = TargetRoot
                        self:CheckTextDistance(TextLabel, TargetRoot, Settings)
                        local Connection
                        Connection = workspace.CurrentCamera:GetPropertyChangedSignal("CameraSubject"):Connect(function()
                            if bg and bg.Parent then
                                for _, v in TextLabel:GetChildren() do v:Cancel() end
                                TextLabel.TextTransparency = 0.95
                                TextLabel.TextStrokeTransparency = 0.95
                            else
                                Connection:Disconnect()
                            end
                        end)
                        bg.Destroying:Once(function() if Connection then Connection:Disconnect() end end)
                        bg.Parent:GetPropertyChangedSignal("Parent"):Once(function() bg:Destroy() end)
                    else
                        local bg = BillboardGui[1]
                        local H, S, V = Settings.Color:ToHSV()
                        local TextLabel = bg.TextLabel
                        TextLabel.TextColor3 = Color3.fromHSV(H, S, V * 1.1)
                        self:CheckTextDistance(TextLabel, TargetRoot, Settings)
                    end
                elseif BillboardGui[1] then
                    BillboardGui[1]:Destroy()
                end
            end,

            ["OnLoop"] = function(self)
                local ESP_on          = GetValue("ESP")
                local ShowText_on     = GetValue("ShowText")
                local AutoPickup_on   = GetValue("AutoPickup")
                local ItemsESP_on     = GetValue("ItemsESP")
                local GenESP_on       = GetValue("GeneratorsESP")
                local GenCheck_on     = GetValue("GeneratorsCheck")

                local fireprompt = fireproximitypromptFunction and function(P)
                    return P and fireproximitypromptFunction(P)
                end or function(P)
                    if P then P:InputHoldBegin(); P:InputHoldEnd() end
                end

                for _, v in PlayersFolder:QueryDescendants("#Killers > Instance,#Survivors > Instance") do
                    local Player = v ~= LocalPlayer.Character and Players:GetPlayerFromCharacter(v)
                    local Hum = v:FindFirstChildOfClass("Humanoid")
                    if Player and Hum and Hum.Health > 0 and MainUI.Enabled then
                        local FolderName = v.Parent.Name
                        local FeatureValue = GetValue(FolderName .. "ESP")
                        local ColorValue   = FolderName == "Killers" and Color3.fromRGB(255, 0, 0) or Color3.fromRGB(0, 255, 0)
                        local TargetRoot   = v:FindFirstChild("HumanoidRootPart")
                        self:CreateDynamicHighlight(FeatureValue, v, TargetRoot, {MaxDistance=100, MinDistance=10, Color=ColorValue})
                        self:CreateText(FeatureValue, v, TargetRoot, {MinDistance=25, Text=Player.Name, Color=ColorValue})
                    else
                        self:CreateDynamicHighlight(false, v)
                        self:CreateText(false, v)
                    end
                end

                if not (InGame and GameMap) then return end

                local Tools = InGame:QueryDescendants("#Map > Tool")
                local DroppedTools = InGame.Parent:QueryDescendants("Folder > Tool")
                for _, v in table.move(Tools, 1, #Tools, #DroppedTools + 1, DroppedTools) do
                    local ColorValue = Color3.fromRGB(255, 215, 0)
                    local TargetRoot = v:FindFirstChildWhichIsA("BasePart")
                    self:CreateDynamicHighlight(ItemsESP_on, v, TargetRoot, {MaxDistance=100, MinDistance=12, Color=ColorValue})
                    self:CreateText(ItemsESP_on, v, TargetRoot, {MinDistance=25, Text=v.Name, Color=ColorValue})
                    if v:IsA("Tool") and AutoPickup_on and not LocalCharacter:FindFirstChild(v.Name)
                            and not LocalPlayer:FindFirstChildOfClass("Backpack"):FindFirstChild(v.Name)
                            and not v:GetAttribute("JustDropped") then
                        local p = OverlapParams.new()
                        p.FilterType = Enum.RaycastFilterType.Include
                        p.FilterDescendantsInstances = {v}
                        if LocalRoot and #workspace:GetPartBoundsInRadius(LocalRoot.Position, 4.5, p) > 0 then
                            fireprompt(v:FindFirstChildWhichIsA("ProximityPrompt", true))
                        end
                    end
                end

                for _, v in GameMap:QueryDescendants("Model#Generator:has(#Main)") do
                    local Progress = v:FindFirstChild("Progress")
                    if not Progress then continue end
                    if GenCheck_on and Progress.Value >= 100 then
                        self:CreateDynamicHighlight(false, v)
                        self:CreateText(false, v)
                    else
                        local ColorValue = Color3.fromRGB(0, 255, 255)
                        local TargetRoot = v:FindFirstChild("Main") or v:WaitForChild("Main")
                        self:CreateDynamicHighlight(GenESP_on, v, TargetRoot, {MaxDistance=100, MinDistance=12, Color=ColorValue})
                        self:CreateText(GenESP_on, v, TargetRoot, {MinDistance=25, Text=v.Name, Color=ColorValue})
                    end
                end
            end
        },

