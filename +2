function RichTextGradientColor(Text:string,Colors) local Count=0 for Char in Text:gmatch(utf8.charpattern) do if Char~=" " then Count+=1 end end if Count==0 then return Text end local MI=math.max(1,Count-1) local Seg=#Colors-1 local R,Used="",0 for Char in Text:gmatch(utf8.charpattern) do if Char==" " then R..=Char elseif Char:byte()>=128 then else local T=Used/MI Used+=1 local S=math.min(math.floor(T*Seg),Seg-1) R..=('<font color="#%s">%s</font>'):format(Colors[S+1]:Lerp(Colors[S+2],T*Seg-S):ToHex(),Char) end end return R end

local function collidewith(g1,g2) local g1t,g1b=g1.AbsolutePosition,g1.AbsolutePosition+g1.AbsoluteSize local g2t,g2b=g2.AbsolutePosition,g2.AbsolutePosition+g2.AbsoluteSize return((g1t.x<g2b.x and g1b.x>g2t.x) and(g1t.y<g2b.y and g1b.y>g2t.y)) end

function TableValueFind(Table,MatchFn,Seen) if type(Table)~="table" or type(MatchFn)~="function" then return nil end Seen=Seen or{} if Seen[Table] then return nil end Seen[Table]=true for K,V in Table do if MatchFn(K,V) then return V,K,Table elseif type(V)=="table" then local FV,FK,FP=TableValueFind(V,MatchFn,Seen) if FK~=nil then return FV,FK,FP end end end return nil end

