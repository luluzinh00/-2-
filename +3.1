                            end

                            -- 🔹 espera a PuzzleUI realmente aparecer (até 3s)
                            local OpenDeadline = tick() + 3
                            local Opened = false
                            while tick() < OpenDeadline do
                                if not GetValue("AutoGeneratorPuzzle") then break end
                                if PlayerGui:FindFirstChild("PuzzleUI") then Opened = true; break end
                                task.wait(0.05)
                            end

                            if not Opened then
                                return -- Remote não abriu puzzle
                            end

                            -- 🔹 A PuzzleUI está aberta → o hook de FlowGame.new
                            -- já está resolvendo o grid via HandlePuzzle.
                            -- Só esperamos a UI fechar ou timeout.
                            local SolveDeadline = tick() + 30
